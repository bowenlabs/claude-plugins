---
interface Props {
  title: string;
  lede: string;
}
const { title, lede } = Astro.props;
---

<section class="hero">
  <h1>{title}</h1>
  <p>{lede}</p>
  <a class="cta" href="/order">Click here to order</a>
</section>

<style>
  .hero {
    background: var(--color-paper);
    padding: var(--space-section) 1.5rem;
  }
  h1 {
    color: #1F2A44;
    font-family: var(--font-heading);
  }
  p {
    color: #6b7280;
  }
  .cta {
    background: var(--color-accent);
    color: #fff;
    padding: 0.25rem 0.5rem;
  }
</style>
